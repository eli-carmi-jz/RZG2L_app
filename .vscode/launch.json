{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug hello on RZG2L (gdbserver)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/hello-debug",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/toolchains/bin/aarch64-none-linux-gnu-gdb.exe",
            "miDebuggerServerAddress": "10.0.0.121:2345",
            "preLaunchTask": "Start gdbserver on board",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "Debug hello on RZG2L (USB serial COM14)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/hello-debug",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/toolchains/bin/aarch64-none-linux-gnu-gdb.exe",
            "miDebuggerServerAddress": "\\\\.\\COM14",
            "preLaunchTask": "USB: Start gdbserver on board",
            "setupCommands": [
                { "text": "set serial baud 115200", "ignoreFailures": false },
                { "text": "set remotetimeout 20", "ignoreFailures": true },
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
